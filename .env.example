# Copy to .env for docker compose. These are local development values.
DB_URI=postgres:localdb@postgres:5432
DB_DATABASE=nakama
DATA_ENV=local.yml

# host ports (change them when something else already owns 7350-7351 on your machine)
NAKAMA_PORT=17360
CONSOLE_PORT=17361

# postgres, only used by the compose stack
POSTGRES_PASSWORD=localdb
