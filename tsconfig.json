{
  "files": [
    "./main.ts",
  ],

  "include": ["games"],

  "compilerOptions": {
        "types": ["nakama-runtime"],
    "target": "es5",
    "typeRoots": [
      "./node_modules"
    ],
    "outFile": "./build/index.js",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}
